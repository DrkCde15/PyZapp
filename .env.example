# --- Public API (FastAPI) ---
# Key the Python SDK sends as X-API-Key. Generate: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-secret
API_PORT=8000
# SQLite file for instance metadata. Empty = in-memory (ephemeral).
DATABASE_PATH=/app/data/pyzapp.db

# --- Internal link API <-> Baileys service ---
# Shared secret sent as X-Internal-Key. Never expose to end users.
INTERNAL_API_KEY=change-me-to-another-long-random-secret

# --- Common ---
LOG_LEVEL=info

# --- AI providers (at least the one you configure per instance) ---
# Per-instance api_key overrides these. Ollama needs no key.
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
